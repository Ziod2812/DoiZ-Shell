#!/usr/bin/env python3
import fcntl
import json
import math
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "doiz"
GRID_PID_FILE = STATE_DIR / "auto-arrange-grid.pid"

import re

SYSTEM_PATTERNS = [
    r"quickshell", r"^qs$", r"dunst", r"mako", r"swaync", r"rofi", r"wofi", r"wlogout",
    r"hypr", r"awww", r"swww", r"mpvpaper", r"xwaylandvideobridge", r"xdg-desktop-portal",
    r"polkit", r"fcitx", r"ibus", r"nm-applet", r"blueman-applet", r"nm-tray", r"network-?manager",
    r"pipewire", r"wireplumber", r"gnome-keyring", r"gcr-prompter", r"kwalletd", r"ssh-askpass",
    r"sddm", r"cliphist", r"wl-clip", r"wl-paste", r"cava", r"snixembed", r"trayer", r"stalonetray",
    r"^$",
]
USER_EXCLUDE = Path.home() / ".config/mycfg/blackhole-exclude.txt"

def load_patterns():
    pats = list(SYSTEM_PATTERNS)
    try:
        for line in USER_EXCLUDE.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                pats.append(line)
    except OSError:
        pass
    out = []
    for p in pats:
        try:
            out.append(re.compile(p, re.I))
        except re.error:
            pass
    return out

def is_system_window(c, patterns):
    names = [(c.get("class") or ""), (c.get("initialClass") or "")]
    if not any(names):
        return True
    for n in names:
        for rx in patterns:
            if rx.search(n):
                return True
    if c.get("xwayland") and not (c.get("title") or "").strip():
        return True
    w, h = c.get("size", [0, 0])
    if w < 40 or h < 40:
        return True
    return False

OPEN_TIME = 1.45
DURATION = 1.15
STAGGER = 0.11
MAX_STAGGER = 0.9
FPS = 45
MIN_SIZE = 28
SPIN = 2.6
SHAKE = 7.0
WOBBLE = 0.06

COOLDOWN = 4.0
LITE_FPS = 30
LITE_WINDOWS = 8
MIN_SLEEP = 0.004

EFFECT = ""
FROZEN = 1
OPEN_MIN = 2.4
CLOSE_LEAD = 0.3
SHOT_FILE = RUNTIME_DIR / "doiz-blackhole-shot.png"
CONFIG_FILE = Path.home() / ".config/mycfg/blackhole.conf"
SETTINGS_FILE = Path.home() / ".config/mycfg/doiz-settings.env"
LAST_FILE = RUNTIME_DIR / "doiz-blackhole.last"

DRY_RUN = "--dry" in sys.argv

def hyprctl(*args, timeout=3):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=timeout)

def hypr_json(*args):
    try:
        r = hyprctl(*args, "-j")
        return json.loads(r.stdout) if r.stdout.strip() else None
    except Exception:
        return None

def batch(cmds):
    if not cmds:
        return
    line = " ; ".join(f"dispatch {c}" for c in cmds)
    try:
        subprocess.run(["hyprctl", "--batch", line], capture_output=True, timeout=5)
    except subprocess.TimeoutExpired:
        pass

def eval_lua(expr):
    hyprctl("eval", expr)

def lua_move(addr, x, y):
    return (f'hl.dsp.window.move({{ window = "address:{addr}", '
            f'x = {int(x)}, y = {int(y)}, relative = false }})')

def lua_resize(addr, w, h):
    return (f'hl.dsp.window.resize({{ window = "address:{addr}", '
            f'x = {int(w)}, y = {int(h)}, relative = false }})')

def lua_close(addr):
    return f'hl.dsp.window.close({{ window = "address:{addr}" }})'

def lua_float_toggle(addr):
    return f'hl.dsp.window.float({{ action = "toggle", window = "address:{addr}" }})'

def lua_focus(addr):
    return f'hl.dsp.focus({{ window = "address:{addr}" }})'

LUA_FULLSCREEN = 'hl.dsp.window.fullscreen({ mode = "fullscreen" })'

def saved_animations():
    try:
        for line in SETTINGS_FILE.read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                if k.strip() == "animations":
                    return 1.0 if v.strip() == "1" else 0.0
    except OSError:
        pass
    return None

def option_number(name, key, default):
    data = hypr_json("getoption", name)
    if isinstance(data, dict) and key in data:
        try:
            return float(data[key])
        except (TypeError, ValueError):
            pass
    return default

def notify(msg):
    subprocess.run(["notify-send", "Black Hole", msg], capture_output=True)

def qs(*args, timeout=3):
    return subprocess.run(["qs", "-c", "blackhole", *args], capture_output=True, text=True, timeout=timeout)

def pick_monitor():
    mons = hypr_json("monitors") or []
    for m in mons:
        if m.get("focused"):
            return m
    return mons[0] if mons else None

def pick_windows(mon):
    patterns = load_patterns()
    ids = {int(mon["activeWorkspace"]["id"])}
    special = int(mon.get("specialWorkspace", {}).get("id", 0) or 0)
    if special:
        ids.add(special)
    out = []
    for c in hypr_json("clients") or []:
        if not c.get("mapped", True) or c.get("hidden", False):
            continue
        if int(c.get("monitor", -1)) != int(mon["id"]):
            continue
        if int(c.get("workspace", {}).get("id", -999)) not in ids:
            continue
        if not c.get("address") or is_system_window(c, patterns):
            continue
        out.append(c)
    return out

def grab_screen(mon):
    try:
        SHOT_FILE.unlink()
    except OSError:
        pass
    try:
        r = subprocess.run(["grim", "-o", mon.get("name", ""), str(SHOT_FILE)],
                           capture_output=True, timeout=4)
    except (OSError, subprocess.TimeoutExpired):
        return False
    try:
        return r.returncode == 0 and SHOT_FILE.stat().st_size > 1000
    except OSError:
        return False

def frozen_windows(mon, wins):
    scale = float(mon.get("scale", 1) or 1)
    mw, mh = mon["width"] / scale, mon["height"] / scale
    hx, hy = mw / 2, mh / 2
    out = []
    for c in wins:
        x, y = c["at"]
        w, h = c["size"]
        x, y = x - mon["x"], y - mon["y"]
        x0, y0 = max(0.0, x), max(0.0, y)
        x1, y1 = min(mw, x + w), min(mh, y + h)
        if x1 - x0 < 8 or y1 - y0 < 8:
            continue
        out.append({"x": round(x0, 1), "y": round(y0, 1), "w": round(x1 - x0, 1), "h": round(y1 - y0, 1),
                    "d": math.hypot(x0 + (x1 - x0) / 2 - hx, y0 + (y1 - y0) / 2 - hy)})
    out.sort(key=lambda i: i["d"])
    for i in out:
        del i["d"]
    return out

def clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))

GL_CACHE = STATE_DIR / "gl-renderer"
SOFTWARE_RE = re.compile(r"llvmpipe|softpipe|swrast|software", re.I)

def gl_renderer():
    try:
        txt = GL_CACHE.read_text().strip()
        if txt:
            return txt
    except OSError:
        pass
    name = "unknown"
    try:
        r = subprocess.run(["eglinfo", "-B"], capture_output=True, text=True, timeout=4)
        for line in r.stdout.splitlines():
            if "renderer" in line.lower() and ":" in line:
                name = line.split(":", 1)[1].strip() or name
                break
    except (OSError, subprocess.TimeoutExpired):
        pass
    if name != "unknown":
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            GL_CACHE.write_text(name)
        except OSError:
            pass
    return name

def mesa_env(env):
    env.setdefault("mesa_glthread", "true")
    env.setdefault("MESA_SHADER_CACHE_MAX_SIZE", "1G")
    env.setdefault("MESA_SHADER_CACHE_DIR", str(Path.home() / ".cache/doiz-mesa"))
    return env

QML_DIR = Path.home() / ".config/quickshell/blackhole"
MESA_BASE = ["mesa", "libglvnd", "vulkan-icd-loader", "mesa-utils"]
VENDOR_PKGS = {"0x1002": "vulkan-radeon", "0x8086": "vulkan-intel", "0x1af4": "vulkan-virtio", "0x15ad": "vulkan-virtio"}

def pkg_installed(name):
    try:
        return subprocess.run(["pacman", "-Q", name], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return True

def wanted_mesa_packages():
    pkgs = list(MESA_BASE)
    for f in Path("/sys/class/drm").glob("card[0-9]*/device/vendor"):
        try:
            extra = VENDOR_PKGS.get(f.read_text().strip())
        except OSError:
            continue
        if extra and extra not in pkgs:
            pkgs.append(extra)
    return pkgs

def ensure_mesa():
    missing = [p for p in wanted_mesa_packages() if not pkg_installed(p)]
    if not missing:
        return True
    notify("Installing Mesa (%s) for the effect, enter your password if asked" % ", ".join(missing))
    for cmd in (["pkexec"], ["sudo", "-n"]):
        try:
            r = subprocess.run(cmd + ["pacman", "-S", "--needed", "--noconfirm", *missing], capture_output=True, timeout=300)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0:
            try:
                GL_CACHE.unlink()
            except OSError:
                pass
            notify("Mesa installed")
            return True
    notify("Could not install Mesa automatically: sudo pacman -S " + " ".join(missing))
    return False

def ensure_shaders():
    for src in QML_DIR.glob("*.frag"):
        out = src.with_name(src.name + ".qsb")
        try:
            if out.exists() and out.stat().st_mtime >= src.stat().st_mtime:
                continue
        except OSError:
            continue
        try:
            subprocess.run(["qsb", "--glsl", "100 es,120,150", "--hlsl", "50", "--msl", "12", "-o", str(out), str(src)],
                           capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return

def load_config():
    keys = {"cooldown": "COOLDOWN", "fps": "FPS", "lite_fps": "LITE_FPS", "lite_windows": "LITE_WINDOWS",
            "shake": "SHAKE", "wobble": "WOBBLE", "frozen": "FROZEN"}
    try:
        lines = CONFIG_FILE.read_text().splitlines()
    except OSError:
        return
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = (x.strip().lower() for x in line.split("=", 1))
        if k == "effect":
            globals()["EFFECT"] = v
            continue
        if k in keys:
            try:
                globals()[keys[k]] = type(globals()[keys[k]])(float(v))
            except (ValueError, TypeError):
                pass

def last_run():
    try:
        return float(LAST_FILE.read_text().strip())
    except (OSError, ValueError):
        return 0.0

def mark_run():
    try:
        LAST_FILE.write_text(str(time.time()))
    except OSError:
        pass

def grid_daemon_pid():
    try:
        return int(GRID_PID_FILE.read_text().strip())
    except Exception:
        return None

def main():
    lock = open(RUNTIME_DIR / "doiz-blackhole.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0

    load_config()
    if COOLDOWN > 0 and 0 <= time.time() - last_run() < COOLDOWN:
        return 0

    mon = pick_monitor()
    if not mon:
        return 1

    ensure_mesa()
    ensure_shaders()

    prev_zoom = option_number("cursor:zoom_factor", "float", 1.0)
    prev_anim = saved_animations()
    if prev_anim is None:
        prev_anim = option_number("animations:enabled", "int", 1.0)
    grid_pid = grid_daemon_pid()
    proc = None
    stopped_grid = False

    try:
        shot_ok = EFFECT == "blackhole" and bool(FROZEN) and grab_screen(mon)
        env = dict(os.environ)
        env.pop("DOIZ_BH_SHOT", None)
        env.pop("DOIZ_BH_WINS", None)
        mesa_env(env)
        renderer = gl_renderer()
        software = bool(SOFTWARE_RE.search(renderer))
        if software:
            notify("Software rendering (%s): lite mode. Check the Mesa GPU driver." % renderer)
        if shot_ok:
            env["DOIZ_BH_SHOT"] = str(SHOT_FILE)
            env["DOIZ_BH_WINS"] = json.dumps(frozen_windows(mon, pick_windows(mon)))
        proc = subprocess.Popen(
            ["qs", "-c", "blackhole"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True, env=env,
        )
        ready = False
        for _ in range(80):
            if proc.poll() is not None:
                break
            try:
                if qs("ipc", "show").returncode == 0:
                    ready = True
                    break
            except Exception:
                pass
            time.sleep(0.05)
        if not ready:
            notify("Quickshell could not start the blackhole overlay")
            return 1

        if grid_pid:
            try:
                os.kill(grid_pid, signal.SIGSTOP)
                stopped_grid = True
            except OSError:
                pass

        if abs(prev_zoom - 1.0) > 0.01:
            eval_lua("hl.config({ cursor = { zoom_factor = 1.0 } })")
        eval_lua("hl.config({ animations = { enabled = false } })")

        wins = pick_windows(mon)

        items = []
        if shot_ok:
            qs("ipc", "call", "blackhole", "open", mon.get("name", ""))
            time.sleep(max(0.0, OPEN_MIN - CLOSE_LEAD))
            if not DRY_RUN:
                batch([lua_close(c["address"]) for c in wins])
            time.sleep(CLOSE_LEAD)
        else:
            prep = []
            for c in wins:
                if c.get("fullscreen"):
                    prep += [lua_focus(c["address"]), LUA_FULLSCREEN]
            for c in wins:
                if not c.get("floating"):
                    prep.append(lua_float_toggle(c["address"]))
            batch(prep)
            if prep:
                time.sleep(0.2)

            fresh = {c["address"]: c for c in pick_windows(mon)}
            scale = float(mon.get("scale", 1) or 1)
            hx = mon["x"] + mon["width"] / scale / 2
            hy = mon["y"] + mon["height"] / scale / 2

            items = []
            for c in wins:
                f = fresh.get(c["address"])
                if not f:
                    continue
                x, y = f["at"]
                w, h = f["size"]
                items.append({
                    "addr": c["address"],
                    "x": x, "y": y, "w": w, "h": h,
                    "was_floating": bool(c.get("floating")),
                    "cx": x + w / 2, "cy": y + h / 2,
                    "done": False, "delay": 0.0, "ph": len(items) * 2.399,
                })
            items.sort(key=lambda i: math.hypot(i["cx"] - hx, i["cy"] - hy))
            step = min(STAGGER, MAX_STAGGER / max(1, len(items) - 1))
            for idx, it in enumerate(items):
                it["delay"] = idx * step
                it["r0"] = math.hypot(it["cx"] - hx, it["cy"] - hy)
                it["a0"] = math.atan2(it["cy"] - hy, it["cx"] - hx)

            qs("ipc", "call", "blackhole", "open", mon.get("name", ""))
            time.sleep(OPEN_TIME)

            total = (max((i["delay"] for i in items), default=0.0) + DURATION) if items else 0.6
            lite = software or len(items) > LITE_WINDOWS
            frame = 1.0 / (LITE_FPS if lite else FPS)
            cost = 0.0
            tick = 0
            start = time.monotonic()
            while True:
                t = time.monotonic() - start
                cmds = []
                for it in items:
                    if it["done"]:
                        continue
                    p = clamp((t - it["delay"]) / DURATION)
                    if p <= 0:
                        continue
                    if p >= 1:
                        it["done"] = True
                        if not DRY_RUN:
                            cmds.append(lua_close(it["addr"]))
                        continue
                    pull = p ** 2.2
                    shrink = p ** 1.5
                    r = it["r0"] * (1 - pull)
                    a = it["a0"] + SPIN * pull
                    s = 1 - 0.97 * shrink
                    tremor = math.sin(math.pi * p) ** 1.5
                    wob = 1.0 if lite else 1.0 + WOBBLE * tremor * math.sin(t * 11.0 + it["ph"])
                    nw = int(max(MIN_SIZE, it["w"] * s * wob))
                    nh = int(max(MIN_SIZE, it["h"] * s / wob))
                    if (nw, nh) != it.get("sz") and (not lite or tick % 2 == 0):
                        cmds.append(lua_resize(it["addr"], nw, nh))
                        it["sz"] = (nw, nh)
                    cw, ch = it.get("sz", (it["w"], it["h"]))
                    amp = SHAKE * tremor * (0.4 + 0.6 * s)
                    jx = amp * math.sin(t * 47.0 + it["ph"])
                    jy = amp * math.cos(t * 61.0 + it["ph"] * 1.7)
                    x = int(hx + r * math.cos(a) - cw / 2 + jx)
                    y = int(hy + r * math.sin(a) - ch / 2 + jy)
                    if (x, y) != it.get("pos"):
                        cmds.append(lua_move(it["addr"], x, y))
                        it["pos"] = (x, y)
                t_batch = time.monotonic()
                batch(cmds)
                spent_batch = time.monotonic() - t_batch
                cost = spent_batch if tick == 0 else 0.7 * cost + 0.3 * spent_batch
                tick += 1
                if not lite and cost > frame * 1.3:
                    lite = True
                    frame = 1.0 / LITE_FPS
                if t >= total:
                    break
                spent = (time.monotonic() - start) - t
                time.sleep(max(frame - spent, MIN_SLEEP))

        qs("ipc", "call", "blackhole", "close")
        try:
            proc.wait(timeout=4)
        except subprocess.TimeoutExpired:
            pass

        if items:
            time.sleep(0.5)
            alive = {c["address"] for c in (hypr_json("clients") or [])}
            back = []
            for it in items:
                if it["addr"] in alive:
                    back.append(lua_resize(it["addr"], it["w"], it["h"]))
                    back.append(lua_move(it["addr"], it["x"], it["y"]))
                    if DRY_RUN and not it["was_floating"]:
                        back.append(lua_float_toggle(it["addr"]))
            batch(back)
        return 0
    finally:
        mark_run()
        eval_lua("hl.config({ animations = { enabled = %s } })" % ("true" if prev_anim else "false"))
        if abs(prev_zoom - 1.0) > 0.01:
            eval_lua("hl.config({ cursor = { zoom_factor = %.4f } })" % prev_zoom)
        if stopped_grid and grid_pid:
            try:
                os.kill(grid_pid, signal.SIGCONT)
            except OSError:
                pass
        if proc and proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass

if __name__ == "__main__":
    sys.exit(main())
